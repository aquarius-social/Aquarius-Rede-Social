{
  "expo": {
    "name": "Aquarius",
    "slug": "aquarius-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aquarius",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0D2B5E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquarius.app"
    },
    "android": {
      "package": "com.aquarius.app",
      "adaptiveIcon": { "backgroundColor": "#0D2B5E" }
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router"]
  }
}
