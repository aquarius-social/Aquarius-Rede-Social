{
  "expo": {
    "name": "Aquarius",
    "slug": "aquarius-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aquarius",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0D2B5E"
    },
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#0D2B5E" }
    },
    "web": { "bundler": "metro", "output": "single" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
