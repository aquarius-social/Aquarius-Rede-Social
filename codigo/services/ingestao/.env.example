# Credenciais do Supabase para a ingestão (processo de servidor privilegiado).
# Copie para `.env` e preencha. NUNCA versione o `.env` real (ver .gitignore).

# URL do projeto Supabase.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# SERVICE ROLE key — ignora RLS. A ingestão escreve como servidor, não como
# cliente. Jamais usar a anon key aqui.
SUPABASE_SERVICE_KEY=SUA-SERVICE-ROLE-KEY

# Opcionais.
AQUARIUS_JANELA_DIAS=30      # janela móvel de releitura (§3.3)
AQUARIUS_LEGISLATURA=57      # legislatura para o coletor de deputados

# Emendas parlamentares (Portal da Transparência, Área F §13). SEM esta chave a
# área é pulada. Cadastro grátis: portaldatransparencia.gov.br/api-de-dados/cadastrar-email
AQUARIUS_TRANSPARENCIA_KEY=  # header `chave-api-dados` (pessoal)
AQUARIUS_EMENDAS_ANOS=       # ex: "2024,2025" — vazio = ano corrente

# Senado (Área I, §17). Fonte pública, sem chave. Padrão ligado; a rodada leve
# pode desligar. Aceita 0/false/nao/off.
AQUARIUS_SENADO=1

# Discursos das duas casas (Área G). Por parlamentar, volumoso — desligue na
# rodada leve. Padrão ligado.
AQUARIUS_DISCURSOS=1

# Despesas CEAPS do Senado (Área A) — CSV anual. Anos a baixar; vazio = ano
# corrente. Só efetiva com AQUARIUS_SENADO ligado.
AQUARIUS_CEAPS_ANOS=       # ex: "2024,2025"

# Eventos das duas casas (agenda legislativa). Padrão ligado; desligue na leve.
AQUARIUS_EVENTOS=1

# Roster completo da legislatura do Senado (titulares + suplentes). 57 = atual.
AQUARIUS_LEGISLATURA_SENADO=57
